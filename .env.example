# Development: bo'sh qoldiring (Vite proxy localhost:5000 ishlatadi)
# Production : Vercel dashboard > Settings > Environment Variables ga qo'shing (Render backend URL)
VITE_API_URL=https://your-backend.onrender.com

# Bot username (LoginPage'da "@bot → /start" havolasi uchun)
VITE_BOT_USERNAME=Dadajon_Cafebot
